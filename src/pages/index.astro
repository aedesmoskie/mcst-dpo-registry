---
export const prerender = false;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>MCST DPO Registry Research</title>

  <style>
    :root {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #e8edf5;
      background: #090d14;
      color-scheme: dark;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #090d14;
    }

    .shell {
      max-width: 1500px;
      margin: auto;
      padding: 32px;
    }

    .top {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 28px;
    }

    h1 {
      font-size: 28px;
      margin: 0 0 8px;
    }

    h2 {
      margin: 0 0 6px;
      font-size: 19px;
    }

    p {
      margin: 0;
      color: #93a0b5;
    }

    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    button,
    a.button {
      border: 1px solid #283244;
      background: #151c28;
      color: #edf2fa;
      border-radius: 8px;
      padding: 10px 14px;
      font-weight: 650;
      text-decoration: none;
      cursor: pointer;
      font: inherit;
    }

    button.primary {
      background: #edf2fa;
      color: #0b1018;
    }

    button.danger {
      border-color: #6c3b3b;
    }

    button:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(5, minmax(150px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .card,
    .panel {
      background: #101620;
      border: 1px solid #222c3b;
      border-radius: 10px;
    }

    .card {
      padding: 16px;
    }

    .label {
      font-size: 12px;
      color: #8290a5;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .value {
      font-size: 26px;
      font-weight: 700;
      margin-top: 7px;
    }

    .lookup {
      padding: 20px;
      margin-bottom: 20px;
    }

    .lookup-header {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 18px;
    }

    .lookup-state {
      font-size: 13px;
      color: #9aa7ba;
    }

    .lookup-grid {
      display: grid;
      grid-template-columns: 140px minmax(180px, 1fr) minmax(220px, 1.5fr);
      gap: 12px;
      margin-bottom: 16px;
    }

    .fieldbox {
      background: #090d14;
      border: 1px solid #273244;
      border-radius: 8px;
      padding: 12px;
    }

    .fieldvalue {
      margin-top: 6px;
      font-size: 15px;
      font-weight: 650;
      word-break: break-word;
    }

    .workflow-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .instructions {
      border-top: 1px solid #222c3b;
      padding-top: 16px;
      color: #8e9caf;
      font-size: 13px;
      line-height: 1.6;
    }

    .result-editor {
      display: none;
      border-top: 1px solid #222c3b;
      padding-top: 18px;
      margin-top: 18px;
    }

    .result-editor.active {
      display: block;
    }

    .editor-row {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1.2fr 1.5fr auto;
      gap: 8px;
      margin-bottom: 8px;
      align-items: center;
    }

    input,
    select {
      width: 100%;
      background: #090d14;
      border: 1px solid #2a3547;
      color: #fff;
      border-radius: 7px;
      padding: 10px 12px;
      font: inherit;
    }

    .editor-actions {
      display: flex;
      gap: 10px;
      margin-top: 12px;
      flex-wrap: wrap;
    }

    .panel {
      overflow: hidden;
    }

    .toolbar {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 14px;
      border-bottom: 1px solid #222c3b;
    }

    .toolbar input {
      flex: 1;
      max-width: 430px;
    }

    .status {
      font-size: 13px;
      color: #9aa7ba;
      margin-left: auto;
    }

    .tablewrap {
      overflow: auto;
      max-height: 58vh;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      min-width: 1200px;
    }

    th,
    td {
      text-align: left;
      padding: 11px 12px;
      border-bottom: 1px solid #202938;
      font-size: 13px;
      vertical-align: top;
    }

    th {
      position: sticky;
      top: 0;
      background: #151c28;
      color: #9eacc0;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    td {
      color: #dce3ed;
    }

    .yes {
      font-weight: 700;
    }

    .warn {
      color: #f1c66d;
    }

    .empty {
      padding: 42px;
      text-align: center;
      color: #7f8da2;
    }

    .note {
      font-size: 12px;
      color: #718096;
      margin-top: 12px;
      line-height: 1.5;
    }

    @media(max-width: 950px) {
      .top,
      .lookup-header {
        display: block;
      }

      .actions {
        margin-top: 18px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .lookup-grid,
      .editor-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
<main class="shell">

  <div class="top">
    <div>
      <h1>MCST DPO Registry Research</h1>
      <p>
        BCA MCST population reconciled against the PDPC DPO Registry
        using UEN as the primary identity key.
      </p>
    </div>

    <div class="actions">
      <button id="sync" class="primary">Sync MCST Records</button>
      <button id="retry">Retry Failed</button>
      <a class="button" href="/api/export.xlsx">Export Excel</a>
    </div>
  </div>


  <section class="cards">
    <div class="card">
      <div class="label">MCST population</div>
      <div class="value" id="total">0</div>
    </div>

    <div class="card">
      <div class="label">Checked</div>
      <div class="value" id="checked">0</div>
    </div>

    <div class="card">
      <div class="label">MCSTs with DPO</div>
      <div class="value" id="withDpo">0</div>
    </div>

    <div class="card">
      <div class="label">DPO rows</div>
      <div class="value" id="dpoRows">0</div>
    </div>

    <div class="card">
      <div class="label">Discrepancies</div>
      <div class="value" id="discrepancies">0</div>
    </div>
  </section>


  <section class="panel lookup">

    <div class="lookup-header">
      <div>
        <h2>PDPC Registry Lookup</h2>
        <p>
          Review each MCST against the official PDPC registry.
        </p>
      </div>

      <div
        class="lookup-state"
        id="lookupState"
      >
        No MCST selected
      </div>
    </div>


    <div class="lookup-grid">
      <div class="fieldbox">
        <div class="label">MCST#</div>
        <div
          class="fieldvalue"
          id="lookupMcst"
        >—</div>
      </div>

      <div class="fieldbox">
        <div class="label">UEN</div>
        <div
          class="fieldvalue"
          id="lookupUen"
        >—</div>
      </div>

      <div class="fieldbox">
        <div class="label">Estate Name</div>
        <div
          class="fieldvalue"
          id="lookupEstate"
        >—</div>
      </div>
    </div>


    <div class="workflow-actions">

      <button
        id="nextLookup"
        class="primary"
      >
        Get Next MCST
      </button>

      <a
        id="openPdpc"
        class="button"
        href="https://www.pdpc.gov.sg/individuals/e-services/data-protection-officers-dpo-registry"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open PDPC Registry
      </a>

      <button
        id="copySearchValue"
        disabled
      >
        Copy Search Value
      </button>

      <button
        id="tryEstate"
        disabled
      >
        Try Estate Name
      </button>

      <button
        id="found"
        disabled
      >
        DPO Result Found
      </button>

      <button
        id="notFound"
        disabled
      >
        No Registry Result
      </button>

      <button
        id="verification"
        disabled
      >
        Verification Required
      </button>

    </div>


    <div class="instructions">
      Search the PDPC Registry using the displayed UEN first. If that search
      returns no result, use <strong>Try Estate Name</strong> and complete the
      estate-name fallback before recording <strong>No Registry Result</strong>.
      Complete any PDPC human verification yourself in the official registry.
      A verification prompt is not a no-result outcome.
    </div>


    <div
      class="result-editor"
      id="resultEditor"
    >
      <div class="label">
        PDPC observations
      </div>

      <div
        id="observationRows"
        style="margin-top:10px"
      ></div>

      <div class="editor-actions">
        <button id="addObservation">
          + Add DPO
        </button>

        <button
          id="submitFound"
          class="primary"
        >
          Save DPO Result
        </button>

        <button id="cancelFound">
          Cancel
        </button>
      </div>
    </div>

  </section>


  <section class="panel">

    <div class="toolbar">

      <input
        id="search"
        placeholder="Search MCST, estate, UEN, DPO name or email"
      />

      <div
        class="status"
        id="status"
      >
        Ready
      </div>

    </div>


    <div class="tablewrap">

      <table>

        <thead>
          <tr>
            <th>MCST#</th>
            <th>Estate Name</th>
            <th>UEN</th>
            <th>DPO(Y/N)</th>
            <th>DPO Name</th>
            <th>DPO Email</th>
            <th>DPO Company</th>
            <th>Record Discrepancy(Y/N)</th>
          </tr>
        </thead>

        <tbody id="rows">
          <tr>
            <td
              colspan="8"
              class="empty"
            >
              No records loaded.
            </td>
          </tr>
        </tbody>

      </table>

    </div>

  </section>


  <div class="note">
    “DPO = N” means no registration was found in a completed PDPC
    Registry lookup. It does not establish that the MCST has no
    appointed DPO outside the registry.
  </div>

</main>


<script>
  const $=(id)=>document.getElementById(id); let currentJob=null,currentSearchType=null,currentSearchValue='',searchTimer;
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  const setStatus=(m)=>{$('status').textContent=m;};
  function setMode(type){if(!currentJob){currentSearchType=null;currentSearchValue='';return;}if(type==='uen'&&currentJob.uen){currentSearchType='uen';currentSearchValue=currentJob.uen;}else{currentSearchType='estate_name';currentSearchValue=currentJob.estateName||'';} $('lookupState').textContent=`Awaiting PDPC result · ${currentSearchType==='uen'?'UEN':'Estate Name'} search`; controls(true);}
  function controls(on){const active=!!(on&&currentJob&&currentSearchValue);$('copySearchValue').disabled=!active;$('found').disabled=!active;$('verification').disabled=!active;$('tryEstate').disabled=!(active&&currentSearchType==='uen'&&currentJob.estateName);$('notFound').disabled=!(active&&(currentSearchType==='estate_name'||!currentJob.estateName));}
  function renderJob(){$('lookupMcst').textContent=currentJob?.mcstNo||'—';$('lookupUen').textContent=currentJob?.uen||'—';$('lookupEstate').textContent=currentJob?.estateName||'—';if(!currentJob){$('lookupState').textContent='No MCST selected';currentSearchType=null;currentSearchValue='';controls(false);}else setMode(currentJob.uen?'uen':'estate_name');}
  function clearEditor(){$('resultEditor').classList.remove('active');$('observationRows').innerHTML='';}
  function addObservationRow(o={}){const c=$('observationRows'),r=document.createElement('div');r.className='editor-row observation-row';const defaultUen=o.uen??(currentSearchType==='uen'?currentJob?.uen||'':'');r.innerHTML=`<input class="organisation" placeholder="PDPC Entity Name" value="${esc(o.organisationName||'')}"/><input class="observation-uen" placeholder="Returned UEN" value="${esc(defaultUen)}"/><input class="dpo-name" placeholder="DPO Name" value="${esc(o.dpoName||'')}"/><input class="dpo-email" placeholder="DPO Email" value="${esc(o.dpoEmail||'')}"/><button type="button" class="remove-observation danger">Remove</button>`;r.querySelector('.remove-observation').onclick=()=>{r.remove();if(!c.querySelector('.observation-row'))addObservationRow();};c.appendChild(r);}
  function collect(){return [...document.querySelectorAll('.observation-row')].map(r=>({organisationName:r.querySelector('.organisation').value.trim(),uen:r.querySelector('.observation-uen').value.trim(),dpoName:r.querySelector('.dpo-name').value.trim(),dpoEmail:r.querySelector('.dpo-email').value.trim(),dpoCompany:''})).filter(x=>x.organisationName||x.uen||x.dpoName||x.dpoEmail);}
  function renderRows(rows){$('rows').innerHTML=rows?.length?rows.map(r=>`<tr><td>${esc(r['MCST#'])}</td><td>${esc(r['Estate Name'])}</td><td>${esc(r['UEN'])}</td><td class="yes">${esc(r['DPO(Y/N)'])}</td><td>${esc(r['DPO Name'])}</td><td>${esc(r['DPO Email'])}</td><td>${esc(r['DPO Company'])}</td><td class="${r['Record Discrepancy(Y/N)']==='Y'?'warn':''}">${esc(r['Record Discrepancy(Y/N)'])}</td></tr>`).join(''):'<tr><td colspan="8" class="empty">No matching records.</td></tr>';}
  async function refreshStatus(){const d=await (await fetch('/api/status',{cache:'no-store'})).json();if(!d.ok)throw Error(d.error||'Status failed.');$('total').textContent=d.population.totalMcsts.toLocaleString();$('checked').textContent=d.results.checkedMcsts.toLocaleString();$('withDpo').textContent=d.results.mcstsWithDpo.toLocaleString();$('dpoRows').textContent=d.results.dpoRows.toLocaleString();$('discrepancies').textContent=d.results.discrepancies.toLocaleString();setStatus(`${d.queue.completionPercent}% complete · ${d.queue.pending} pending · ${d.queue.failed} failed`);}
  async function loadRows(){const d=await (await fetch('/api/records',{cache:'no-store'})).json();if(!d.ok)throw Error(d.error||'Records failed.');renderRows(d.rows);}
  async function next(){clearEditor();$('nextLookup').disabled=true;try{const d=await (await fetch('/api/run-batch',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({batchSize:1})})).json();if(!d.ok)throw Error(d.error);currentJob=d.jobs?.[0]||null;renderJob();setStatus(currentJob?`Ready for PDPC lookup: MCST ${currentJob.mcstNo}`:(d.done?'All queued MCST lookups are complete.':'No pending MCST is currently available.'));}catch(e){setStatus(e.message||String(e));}finally{$('nextLookup').disabled=false;}}
  async function submit(payload){const d=await (await fetch('/api/submit-pdpc-result',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({mcstNo:currentJob.mcstNo,...payload})})).json();if(!d.ok)throw Error(d.error||'Unable to save PDPC result.');return d;}
  async function finish(payload){try{controls(false);setStatus('Saving PDPC result…');await submit(payload);currentJob=null;renderJob();clearEditor();await Promise.all([refreshStatus(),loadRows()]);await next();}catch(e){setStatus(e.message||String(e));controls(true);}}
  $('nextLookup').onclick=next;
  $('copySearchValue').onclick=async()=>{if(!currentSearchValue)return;try{await navigator.clipboard.writeText(currentSearchValue);setStatus(`Copied ${currentSearchType==='uen'?'UEN':'estate name'}: ${currentSearchValue}`);}catch{setStatus('Unable to copy search value.');}};
  $('tryEstate').onclick=()=>{if(!currentJob?.estateName)return;clearEditor();setMode('estate_name');setStatus(`UEN search returned no result. Search PDPC by estate name for MCST ${currentJob.mcstNo}.`);};
  $('found').onclick=()=>{$('observationRows').innerHTML='';addObservationRow();$('resultEditor').classList.add('active');};
  $('addObservation').onclick=()=>addObservationRow();
  $('cancelFound').onclick=clearEditor;
  $('submitFound').onclick=async()=>{const observations=collect();if(!observations.length)return setStatus('Enter at least one PDPC DPO result.');await finish({status:'found',searchType:currentSearchType,searchValue:currentSearchValue,observations});};
  $('notFound').onclick=async()=>{if(currentSearchType==='uen'&&currentJob?.estateName)return setStatus('Complete the Estate Name fallback before recording No Registry Result.');if(!confirm(`Confirm the completed PDPC ${currentSearchType==='uen'?'UEN':'Estate Name'} search returned no registry result.`))return;await finish({status:'not_found',searchType:currentSearchType,searchValue:currentSearchValue});};
  $('verification').onclick=async()=>{try{await submit({status:'verification_required',searchType:currentSearchType,searchValue:currentSearchValue});setStatus('Verification required. No DPO result was recorded.');}catch(e){setStatus(e.message||String(e));}};
  $('sync').onclick=async()=>{try{$('sync').disabled=true;setStatus('Synchronising BCA…');const d=await (await fetch('/api/sync-bca',{method:'POST'})).json();if(!d.ok)throw Error(d.error);currentJob=null;renderJob();clearEditor();await Promise.all([refreshStatus(),loadRows()]);}catch(e){setStatus(e.message||String(e));}finally{$('sync').disabled=false;}};
  $('retry').onclick=async()=>{try{const d=await (await fetch('/api/retry-failed',{method:'POST'})).json();if(!d.ok)throw Error(d.error);await refreshStatus();}catch(e){setStatus(e.message||String(e));}};
  $('search').addEventListener('input',()=>{clearTimeout(searchTimer);searchTimer=setTimeout(async()=>{const q=$('search').value.trim();if(!q)return loadRows();try{const d=await (await fetch('/api/search?q='+encodeURIComponent(q))).json();if(!d.ok)throw Error(d.error);renderRows(d.rows);}catch(e){setStatus(e.message||String(e));}},250);});

  async function initialise(){
    renderJob();

    try {
      $('sync').disabled=true;
      setStatus('Checking latest BCA MCST records…');

      const response=await fetch('/api/sync-bca',{
        method:'POST',
        cache:'no-store'
      });

      const d=await response.json();

      if(!d.ok){
        throw Error(d.error||'BCA synchronisation failed.');
      }

      await Promise.all([
        refreshStatus(),
        loadRows()
      ]);
    } catch(e) {
      try {
        await Promise.all([
          refreshStatus(),
          loadRows()
        ]);

        setStatus(
          `Latest BCA sync unavailable · showing cached records · ${
            e.message||String(e)
          }`
        );
      } catch(loadError) {
        setStatus(
          loadError.message||
          String(loadError)
        );
      }
    } finally {
      $('sync').disabled=false;
    }
  }

  initialise();
</script>

</body>
</html>
