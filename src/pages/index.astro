---
export const prerender = false;
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta
		name="viewport"
		content="width=device-width, initial-scale=1"
	/>

	<title>MCST DPO Registry</title>

	<style>
		:root {
			font-family:
				Inter,
				ui-sans-serif,
				system-ui,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				sans-serif;

			color: #e8eef7;
			background: #07111f;
			color-scheme: dark;

			--background: #07111f;
			--sidebar: #081525;
			--surface: #0d1b2c;
			--surface-raised: #102238;
			--surface-soft: #0a1727;
			--border: rgba(148, 174, 207, 0.14);
			--border-strong: rgba(148, 174, 207, 0.24);
			--text: #e8eef7;
			--muted: #8fa0b5;
			--muted-2: #64768c;
			--accent: #16b8d4;
			--accent-soft: rgba(22, 184, 212, 0.12);
			--success: #28d17c;
			--warning: #f1b84b;
			--danger: #ef6262;
			--shadow: 0 18px 60px rgba(0, 0, 0, 0.2);
		}

		* {
			box-sizing: border-box;
		}

		html,
		body {
			margin: 0;
			min-height: 100%;
			background:
				radial-gradient(
					circle at 70% -20%,
					rgba(24, 114, 148, 0.15),
					transparent 38%
				),
				var(--background);
		}

		body {
			min-height: 100vh;
		}

		button,
		input,
		select {
			font: inherit;
		}

		button {
			color: inherit;
		}

		.app {
			display: grid;
			grid-template-columns: 228px minmax(0, 1fr);
			min-height: 100vh;
		}

		.sidebar {
			position: sticky;
			top: 0;
			height: 100vh;
			padding: 24px 18px;
			background:
				linear-gradient(
					180deg,
					rgba(13, 34, 54, 0.96),
					rgba(7, 19, 33, 0.98)
				);
			border-right: 1px solid var(--border);
		}

		.brand {
			display: flex;
			align-items: center;
			gap: 11px;
			padding: 0 10px 24px;
			border-bottom: 1px solid var(--border);
		}

		.brand-mark {
			display: grid;
			place-items: center;
			width: 32px;
			height: 32px;
			border: 1px solid rgba(49, 207, 231, 0.45);
			border-radius: 9px;
			background: rgba(20, 177, 204, 0.1);
			color: #38d5e9;
		}

		.brand-copy strong {
			display: block;
			font-size: 14px;
			letter-spacing: 0.14em;
		}

		.brand-copy span {
			display: block;
			margin-top: 3px;
			color: var(--muted-2);
			font-size: 9px;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.nav {
			display: grid;
			gap: 6px;
			margin-top: 24px;
		}

		.nav-item {
			display: flex;
			align-items: center;
			gap: 12px;
			width: 100%;
			min-height: 42px;
			padding: 0 12px;
			border: 0;
			border-radius: 8px;
			background: transparent;
			color: #8091a6;
			text-align: left;
			cursor: default;
		}

		.nav-item.active {
			background:
				linear-gradient(
					90deg,
					rgba(22, 184, 212, 0.16),
					rgba(22, 184, 212, 0.04)
				);
			color: #31cfe7;
		}

		.nav-icon {
			width: 18px;
			height: 18px;
			flex: 0 0 auto;
		}

		.sidebar-footer {
			position: absolute;
			right: 18px;
			bottom: 22px;
			left: 18px;
			padding-top: 18px;
			border-top: 1px solid var(--border);
			color: var(--muted-2);
			font-size: 11px;
		}

		.main {
			min-width: 0;
			padding: 28px 32px 40px;
		}

		.content {
			max-width: 1540px;
			margin: 0 auto;
		}

		.breadcrumb {
			margin-bottom: 15px;
			color: #70839a;
			font-size: 12px;
		}

		.breadcrumb span {
			color: #b5c3d4;
		}

		.title-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
			padding-bottom: 20px;
			border-bottom: 1px solid var(--border);
		}

		h1 {
			margin: 0;
			font-size: clamp(26px, 2.3vw, 36px);
			font-weight: 700;
			letter-spacing: -0.035em;
		}

		h2 {
			margin: 0;
			font-size: 18px;
			font-weight: 650;
			letter-spacing: -0.015em;
		}

		.assistant-row {
			display: flex;
			align-items: center;
			gap: 10px;
			margin-top: 20px;
		}

		.assistant-box {
			position: relative;
			flex: 1;
			max-width: 900px;
		}

		.assistant-box svg {
			position: absolute;
			top: 50%;
			left: 15px;
			width: 18px;
			height: 18px;
			color: #71859d;
			transform: translateY(-50%);
			pointer-events: none;
		}

		input,
		select {
			width: 100%;
			height: 42px;
			border: 1px solid var(--border-strong);
			border-radius: 8px;
			outline: none;
			background: rgba(5, 15, 27, 0.78);
			color: var(--text);
			transition:
				border-color 120ms ease,
				box-shadow 120ms ease,
				background 120ms ease;
		}

		input {
			padding: 0 13px;
		}

		.assistant-box input {
			padding-left: 44px;
		}

		input::placeholder {
			color: #61748b;
		}

		input:focus,
		select:focus {
			border-color: rgba(37, 199, 222, 0.65);
			box-shadow: 0 0 0 3px rgba(22, 184, 212, 0.08);
			background: rgba(7, 20, 35, 0.94);
		}

		.icon-button {
			position: relative;
			display: inline-grid;
			place-items: center;
			width: 42px;
			height: 42px;
			flex: 0 0 42px;
			padding: 0;
			border: 1px solid var(--border-strong);
			border-radius: 8px;
			background:
				linear-gradient(
					180deg,
					rgba(18, 39, 61, 0.96),
					rgba(10, 25, 42, 0.96)
				);
			cursor: pointer;
			transition:
				transform 120ms ease,
				border-color 120ms ease,
				background 120ms ease;
		}

		.icon-button:hover {
			border-color: rgba(44, 204, 226, 0.5);
			background: rgba(18, 50, 72, 0.96);
		}

		.icon-button:active {
			transform: translateY(1px);
		}

		.icon-button:disabled {
			opacity: 0.4;
			cursor: not-allowed;
		}

		.icon-button svg {
			width: 18px;
			height: 18px;
		}

		.icon-button.accent {
			border-color: rgba(22, 184, 212, 0.48);
			background:
				linear-gradient(
					180deg,
					rgba(15, 119, 145, 0.9),
					rgba(10, 87, 110, 0.9)
				);
		}

		.tooltip::after {
			position: absolute;
			z-index: 100;
			top: calc(100% + 9px);
			left: 50%;
			padding: 6px 8px;
			border: 1px solid var(--border-strong);
			border-radius: 6px;
			background: #111e2d;
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
			color: #dce7f4;
			content: attr(data-tooltip);
			font-size: 11px;
			font-weight: 500;
			line-height: 1;
			opacity: 0;
			pointer-events: none;
			transform: translate(-50%, -3px);
			transition:
				opacity 100ms ease,
				transform 100ms ease;
			white-space: nowrap;
		}

		.tooltip:hover::after {
			opacity: 1;
			transform: translate(-50%, 0);
		}

		.status-row {
			display: flex;
			align-items: center;
			gap: 18px;
			min-height: 39px;
			margin-top: 3px;
			border-bottom: 1px solid var(--border);
			color: var(--muted);
			font-size: 12px;
		}

		.system-status {
			min-width: 0;
			margin-right: auto;
			overflow: hidden;
			color: #8ea0b5;
			font-style: italic;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.health {
			display: flex;
			align-items: center;
			gap: 5px;
		}

		.health-dot {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: #33465b;
			box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.025);
		}

		.health-dot.green.active {
			background: var(--success);
			box-shadow: 0 0 10px rgba(40, 209, 124, 0.42);
		}

		.health-dot.amber.active {
			background: var(--warning);
			box-shadow: 0 0 10px rgba(241, 184, 75, 0.42);
		}

		.health-dot.red.active {
			background: var(--danger);
			box-shadow: 0 0 10px rgba(239, 98, 98, 0.42);
		}

		.last-sync {
			color: #71849a;
			white-space: nowrap;
		}

		.stats {
			display: grid;
			grid-template-columns: repeat(5, minmax(130px, 1fr));
			gap: 12px;
			margin-top: 22px;
		}

		.stat {
			position: relative;
			min-height: 104px;
			padding: 18px;
			overflow: hidden;
			border: 1px solid var(--border);
			border-radius: 10px;
			background:
				linear-gradient(
					145deg,
					rgba(15, 32, 51, 0.96),
					rgba(10, 23, 39, 0.96)
				);
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		}

		.stat::after {
			position: absolute;
			right: -25px;
			bottom: -45px;
			width: 100px;
			height: 100px;
			border-radius: 50%;
			background: rgba(22, 184, 212, 0.035);
			content: "";
		}

		.stat-label {
			color: #74869d;
			font-size: 10px;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.stat-value {
			margin-top: 9px;
			font-size: 28px;
			font-weight: 700;
			letter-spacing: -0.03em;
		}

		.panel {
			margin-top: 20px;
			border: 1px solid var(--border);
			border-radius: 10px;
			background:
				linear-gradient(
					145deg,
					rgba(13, 29, 47, 0.97),
					rgba(8, 21, 36, 0.98)
				);
			box-shadow: var(--shadow);
		}

		.search-panel {
			padding: 20px;
		}

		.panel-heading {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
			margin-bottom: 17px;
		}

		.registry-search-row {
			display: grid;
			grid-template-columns:
				minmax(100px, 0.8fr)
				minmax(150px, 1.05fr)
				minmax(210px, 1.65fr)
				minmax(180px, 1.25fr)
				minmax(210px, 1.5fr)
				42px
				42px;
			gap: 10px;
			align-items: end;
		}

		.form-field label {
			display: block;
			margin-bottom: 7px;
			color: #7d8fa5;
			font-size: 10px;
			font-weight: 700;
			letter-spacing: 0.07em;
			text-transform: uppercase;
		}

		.table-panel {
			overflow: hidden;
		}

		.table-header {
			display: flex;
			align-items: center;
			gap: 16px;
			min-height: 61px;
			padding: 0 18px;
			border-bottom: 1px solid var(--border);
		}

		.table-title {
			font-size: 15px;
			font-weight: 650;
			white-space: nowrap;
		}

		.result-count {
			margin-left: 5px;
			color: #667a91;
			font-size: 11px;
			font-weight: 500;
		}

		.keyword-wrap {
			position: relative;
			width: min(370px, 38vw);
			margin-left: auto;
		}

		.keyword-wrap svg {
			position: absolute;
			top: 50%;
			left: 12px;
			width: 15px;
			height: 15px;
			color: #64788f;
			transform: translateY(-50%);
		}

		.keyword-wrap input {
			height: 36px;
			padding-left: 36px;
			font-size: 12px;
		}

		.tablewrap {
			max-height: 520px;
			overflow: auto;
		}

		table {
			width: 100%;
			min-width: 1120px;
			border-collapse: collapse;
		}

		th,
		td {
			padding: 12px 13px;
			border-bottom: 1px solid rgba(148, 174, 207, 0.09);
			text-align: left;
			vertical-align: middle;
		}

		th {
			position: sticky;
			z-index: 5;
			top: 0;
			background: #0d1b2c;
			color: #788ba2;
			font-size: 10px;
			font-weight: 700;
			letter-spacing: 0.055em;
			text-transform: uppercase;
		}

		td {
			color: #cbd6e3;
			font-size: 12px;
		}

		tbody tr:hover td {
			background: rgba(31, 80, 105, 0.09);
		}

		.th-content {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 7px;
		}

		.column-menu-button {
			display: grid;
			place-items: center;
			width: 22px;
			height: 22px;
			padding: 0;
			border: 0;
			border-radius: 5px;
			background: transparent;
			color: #536b83;
			cursor: pointer;
		}

		.column-menu-button:hover,
		.column-menu-button.active {
			background: rgba(22, 184, 212, 0.1);
			color: #2cc8df;
		}

		.column-menu-button svg {
			width: 13px;
			height: 13px;
		}

		.column-menu {
			position: fixed;
			z-index: 200;
			display: none;
			width: 210px;
			padding: 9px;
			border: 1px solid var(--border-strong);
			border-radius: 8px;
			background: #101e2e;
			box-shadow: 0 18px 45px rgba(0, 0, 0, 0.4);
		}

		.column-menu.open {
			display: block;
		}

		.column-menu button {
			display: block;
			width: 100%;
			padding: 8px 9px;
			border: 0;
			border-radius: 5px;
			background: transparent;
			color: #b8c5d5;
			font-size: 12px;
			text-align: left;
			cursor: pointer;
		}

		.column-menu button:hover {
			background: rgba(22, 184, 212, 0.09);
			color: #e5f4f7;
		}

		.column-filter-input {
			height: 34px;
			margin-top: 6px;
			font-size: 12px;
		}

		.column-menu .yn-options {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 5px;
			margin-top: 6px;
		}

		.column-menu .yn-options button {
			padding: 7px 5px;
			border: 1px solid var(--border);
			text-align: center;
		}

		.empty {
			height: 190px;
			color: #61758c;
			text-align: center;
		}

		.empty strong {
			display: block;
			margin-bottom: 6px;
			color: #8193a8;
			font-size: 13px;
			font-weight: 550;
		}

		.yes {
			color: #70dfad;
			font-weight: 650;
		}

		.warn {
			color: #f1c66d;
			font-weight: 650;
		}

		.table-footer {
			display: flex;
			align-items: center;
			gap: 16px;
			min-height: 60px;
			padding: 10px 18px;
			border-top: 1px solid var(--border);
			color: #71849a;
			font-size: 11px;
		}

		.page-size {
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.page-size select {
			width: 67px;
			height: 32px;
			padding: 0 8px;
			font-size: 11px;
		}

		.pagination {
			display: flex;
			align-items: center;
			gap: 5px;
			margin-left: auto;
		}

		.page-button {
			display: grid;
			place-items: center;
			min-width: 30px;
			height: 30px;
			padding: 0 8px;
			border: 1px solid transparent;
			border-radius: 6px;
			background: transparent;
			color: #8193a8;
			cursor: pointer;
			font-size: 11px;
		}

		.page-button:hover:not(:disabled) {
			border-color: var(--border);
			background: rgba(22, 184, 212, 0.06);
		}

		.page-button.active {
			border-color: rgba(22, 184, 212, 0.35);
			background: rgba(22, 184, 212, 0.12);
			color: #31cfe7;
		}

		.page-button:disabled {
			opacity: 0.32;
			cursor: default;
		}

		.jump {
			display: flex;
			align-items: center;
			gap: 7px;
			margin-left: 8px;
		}

		.jump input {
			width: 54px;
			height: 30px;
			padding: 0 7px;
			font-size: 11px;
			text-align: center;
		}

		.modal-backdrop {
			position: fixed;
			z-index: 500;
			inset: 0;
			display: none;
			place-items: center;
			padding: 20px;
			background: rgba(2, 8, 15, 0.72);
			backdrop-filter: blur(6px);
		}

		.modal-backdrop.open {
			display: grid;
		}

		.modal {
			width: min(440px, 100%);
			padding: 24px;
			border: 1px solid var(--border-strong);
			border-radius: 12px;
			background:
				linear-gradient(
					145deg,
					#122238,
					#0a1727
				);
			box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55);
		}

		.modal h3 {
			margin: 0 0 10px;
			font-size: 18px;
		}

		.modal p {
			margin: 0;
			color: #8799ae;
			font-size: 13px;
			line-height: 1.6;
		}

		.modal-actions {
			display: flex;
			justify-content: flex-end;
			gap: 9px;
			margin-top: 22px;
		}

		.text-button {
			min-height: 38px;
			padding: 0 15px;
			border: 1px solid var(--border-strong);
			border-radius: 7px;
			background: #122238;
			color: #cdd8e5;
			cursor: pointer;
		}

		.text-button.primary {
			border-color: rgba(22, 184, 212, 0.45);
			background: #0d718a;
			color: white;
		}

		@media (max-width: 1180px) {
			.app {
				grid-template-columns: 76px minmax(0, 1fr);
			}

			.sidebar {
				padding-inline: 12px;
			}

			.brand-copy,
			.nav-item span,
			.sidebar-footer {
				display: none;
			}

			.brand {
				justify-content: center;
				padding-inline: 0;
			}

			.nav-item {
				justify-content: center;
				padding: 0;
			}

			.registry-search-row {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 820px) {
			.main {
				padding: 22px 16px 32px;
			}

			.stats {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.assistant-row {
				flex-wrap: wrap;
			}

			.assistant-box {
				flex-basis: 100%;
				max-width: none;
			}

			.registry-search-row {
				grid-template-columns: 1fr;
			}

			.table-footer {
				flex-wrap: wrap;
			}

			.pagination {
				margin-left: 0;
			}
		}
	</style>
</head>

<body>
	<div class="app">
		<aside class="sidebar">
			<div class="brand">
				<div class="brand-mark">
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
					>
						<path d="M5 18V9l7-4 7 4v9" />
						<path d="M8 18v-6h8v6" />
						<path d="M3 19h18" />
					</svg>
				</div>

				<div class="brand-copy">
					<strong>CERULIUS</strong>
					<span>DPOaaS Platform</span>
				</div>
			</div>

			<nav class="nav">
				<button class="nav-item" type="button">
					<svg
						class="nav-icon"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
					>
						<rect x="4" y="4" width="6" height="6" rx="1" />
						<rect x="14" y="4" width="6" height="6" rx="1" />
						<rect x="4" y="14" width="6" height="6" rx="1" />
						<rect x="14" y="14" width="6" height="6" rx="1" />
					</svg>
					<span>Dashboard</span>
