			<h3 id="syncModalTitle">
				Synchronise MCST records?
			</h3>

			<p>
				This will retrieve the latest source records and
				reconcile changes with the registry database.
				Existing registry statistics remain unchanged until
				you explicitly perform this synchronisation.
			</p>

			<div class="modal-actions">
				<button
					id="cancelSync"
					class="text-button"
					type="button"
				>
					Cancel
				</button>

				<button
					id="confirmSync"
					class="text-button primary"
					type="button"
				>
					Synchronise
				</button>
			</div>
		</div>
	</div>

	<script>
		const $ = (id) =>
			document.getElementById(id);

		const state = {
			page: 1,
			pageSize: 25,
			total: 0,
			totalPages: 0,
			mode: 'empty',
			keyword: '',
			search: {
				mcst: '',
				uen: '',
				estate: '',
				dpoName: '',
				dpoEmail: ''
			},
			columnFilters: {},
			sortColumn: '',
			sortDirection: '',
			activeColumn: ''
		};

		const columnMap = {
			mcst: 'MCST#',
			estate: 'Estate Name',
			uen: 'UEN',
			dpo: 'DPO(Y/N)',
			dpoName: 'DPO Name',
			dpoEmail: 'DPO Email',
			dpoCompany: 'DPO Company',
			discrepancy: 'Record Discrepancy(Y/N)'
		};

		const escapeHtml = (value) =>
			String(value ?? '')
				.replace(
					/[&<>"']/g,
					(character) => ({
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						'"': '&quot;',
						"'": '&#39;'
					})[character]
				);

		function setSystemStatus(
			message,
			health = 'green'
		) {
			$('systemStatus').textContent =
				message;

			$('healthGreen')
				.classList.toggle(
					'active',
					health === 'green'
				);

			$('healthAmber')
				.classList.toggle(
					'active',
					health === 'amber'
				);

			$('healthRed')
				.classList.toggle(
					'active',
					health === 'red'
				);
		}

		function setIdle() {
			setSystemStatus(
				'System idle',
				'green'
			);
		}

		function formatSync(value) {
			if (!value) {
				return 'Last sync: —';
			}

			const date =
				new Date(value);

			if (
				Number.isNaN(
					date.getTime()
				)
			) {
				return `Last sync: ${value}`;
			}

			return (
				'Last sync: ' +
				new Intl.DateTimeFormat(
					'en-SG',
					{
						dateStyle: 'medium',
						timeStyle: 'short'
					}
				).format(date)
			);
		}

		async function refreshStatus() {
			const response =
				await fetch(
					'/api/status',
					{
						cache: 'no-store'
					}
				);

			const data =
				await response.json();

			if (!data.ok) {
				throw new Error(
					data.error ||
					'Unable to retrieve registry status.'
				);
			}

			$('total').textContent =
				Number(
					data.population
						?.totalMcsts ?? 0
				).toLocaleString();

			$('checked').textContent =
				Number(
					data.results
						?.checkedMcsts ?? 0
				).toLocaleString();

			$('withDpo').textContent =
				Number(
					data.results
						?.mcstsWithDpo ?? 0
				).toLocaleString();

			$('dpoRows').textContent =
				Number(
					data.results
						?.dpoRows ?? 0
				).toLocaleString();

			$('discrepancies').textContent =
				Number(
					data.results
						?.discrepancies ?? 0
				).toLocaleString();

			$('lastSync').textContent =
				formatSync(
					data.lastSync
				);
		}

		function collectSearch() {
			return {
				mcst:
					$('searchMcst')
						.value
						.trim(),

				uen:
					$('searchUen')
						.value
						.trim(),

				estate:
					$('searchEstate')
						.value
						.trim(),

				dpoName:
					$('searchDpoName')
						.value
						.trim(),

				dpoEmail:
					$('searchDpoEmail')
						.value
						.trim()
			};
		}

		function hasSearchValues(
			search
		) {
			return Object
				.values(search)
				.some(Boolean);
		}

		function renderRows(rows) {
			if (!rows?.length) {
				$('rows').innerHTML = `
					<tr>
						<td
							colspan="8"
							class="empty"
						>
							<strong>No records to display</strong>
							No registry records matched the current search or filters.
						</td>
					</tr>
				`;

				return;
			}

			$('rows').innerHTML =
				rows
					.map(
						(row) => `
							<tr>
								<td>${escapeHtml(row['MCST#'])}</td>
								<td>${escapeHtml(row['Estate Name'])}</td>
								<td>${escapeHtml(row['UEN'])}</td>
								<td class="${row['DPO(Y/N)'] === 'Y' ? 'yes' : ''}">
									${escapeHtml(row['DPO(Y/N)'])}
								</td>
								<td>${escapeHtml(row['DPO Name'])}</td>
								<td>${escapeHtml(row['DPO Email'])}</td>
								<td>${escapeHtml(row['DPO Company'])}</td>
								<td class="${row['Record Discrepancy(Y/N)'] === 'Y' ? 'warn' : ''}">
									${escapeHtml(row['Record Discrepancy(Y/N)'])}
								</td>
							</tr>
						`
					)
					.join('');
		}

		function updatePagination() {
			const total =
				state.total;

			const page =
				state.page;

			const pageSize =
				state.pageSize;

			const totalPages =
				state.totalPages;

			$('resultCount').textContent =
				`${total.toLocaleString()} ${
					total === 1
						? 'result'
						: 'results'
				}`;

			if (!total) {
				$('rangeText').textContent =
					'0 records';
			} else {
				const start =
					(page - 1) *
					pageSize +
					1;

				const end =
					Math.min(
						page * pageSize,
						total
					);

				$('rangeText').textContent =
					`${start.toLocaleString()}–${end.toLocaleString()} of ${total.toLocaleString()}`;
			}

			$('firstPage').disabled =
				page <= 1 ||
				totalPages <= 1;

			$('previousPage').disabled =
				page <= 1 ||
				totalPages <= 1;

			$('nextPage').disabled =
				page >= totalPages ||
				totalPages <= 1;

			$('lastPage').disabled =
				page >= totalPages ||
				totalPages <= 1;

			$('jumpPage').value =
				String(
					totalPages
						? page
						: 1
				);

			$('jumpPage').max =
				String(
					Math.max(
						totalPages,
						1
					)
				);

			renderPageNumbers();
		}

		function renderPageNumbers() {
			const container =
				$('pageNumbers');

			container.innerHTML = '';

			if (!state.totalPages) {
				return;
			}

			let start =
				Math.max(
					1,
					state.page - 2
				);

			let end =
				Math.min(
					state.totalPages,
					start + 4
				);

			start =
				Math.max(
					1,
					end - 4
				);

			for (
				let page = start;
				page <= end;
				page += 1
			) {
				const button =
					document.createElement(
						'button'
					);

				button.type = 'button';
				button.className =
					'page-button';

				if (
					page === state.page
				) {
					button.classList.add(
						'active'
					);
				}

				button.textContent =
					String(page);

				button.onclick = () => {
					state.page = page;
					loadRegistry();
				};

				container.appendChild(
					button
				);
			}
		}

		function buildRegistryUrl() {
			const params =
				new URLSearchParams();

			params.set(
				'page',
				String(state.page)
			);

			params.set(
				'pageSize',
				String(state.pageSize)
			);

			if (
				state.mode === 'full'
			) {
				params.set(
					'full',
					'1'
				);
			}

			for (
				const [
					key,
					value
				] of Object.entries(
					state.search
				)
			) {
				if (value) {
					params.set(
						key,
						value
					);
				}
			}

			if (state.keyword) {
				params.set(
					'keyword',
					state.keyword
				);
			}

			for (
				const [
					key,
					value
				] of Object.entries(
					state.columnFilters
				)
			) {
				if (value) {
					params.set(
						`filter_${key}`,
						String(value)
					);
				}
			}

			if (
				state.sortColumn &&
				state.sortDirection
			) {
				params.set(
					'sort',
					state.sortColumn
				);

				params.set(
					'direction',
					state.sortDirection
				);
			}

			return (
				'/api/search?' +
				params.toString()
			);
		}

		async function loadRegistry() {
			if (
				state.mode === 'empty'
			) {
				state.total = 0;
				state.totalPages = 0;
				renderRows([]);
				updatePagination();
				return;
			}

			try {
				setSystemStatus(
					'Searching registry...',
					'amber'
				);

				const response =
					await fetch(
						buildRegistryUrl(),
						{
							cache:
								'no-store'
						}
					);

				const data =
					await response.json();

				if (!data.ok) {
					throw new Error(
						data.error ||
						'Registry search failed.'
					);
				}

				state.total =
					Number(
						data.total ?? 0
					);

				state.totalPages =
					Number(
						data.totalPages ?? 0
					);

				if (
					state.totalPages &&
					state.page >
						state.totalPages
				) {
					state.page =
						state.totalPages;

					return loadRegistry();
				}

				renderRows(
					data.rows ?? []
				);

				updatePagination();

				setIdle();
			} catch (error) {
				renderRows([]);

				state.total = 0;
				state.totalPages = 0;

				updatePagination();

				setSystemStatus(
					error instanceof Error
						? error.message
						: String(error),
					'red'
				);
			}
		}

		function executeSearch() {
			const search =
				collectSearch();

			if (
				!hasSearchValues(search)
			) {
				state.mode = 'empty';
				state.search = search;
				state.page = 1;

				renderRows([]);
				state.total = 0;
				state.totalPages = 0;
				updatePagination();

				setSystemStatus(
					'Enter at least one search parameter.',
					'amber'
				);

				return;
			}

			state.search = search;
			state.mode = 'search';
			state.page = 1;

			loadRegistry();
		}

		function loadFullRegistry() {
			state.mode = 'full';
			state.search = {
				mcst: '',
				uen: '',
				estate: '',
				dpoName: '',
				dpoEmail: ''
			};

			$('searchMcst').value = '';
			$('searchUen').value = '';
			$('searchEstate').value = '';
			$('searchDpoName').value = '';
			$('searchDpoEmail').value = '';

			state.page = 1;

			loadRegistry();
		}

		function closeColumnMenu() {
			$('columnMenu')
				.classList
				.remove('open');

			document
				.querySelectorAll(
					'.column-menu-button'
				)
				.forEach(
					(button) =>
						button
							.classList
							.remove('active')
				);
		}

		function openColumnMenu(
			button
		) {
			const column =
				button.dataset.column;

			state.activeColumn =
				column;

			const menu =
				$('columnMenu');

			const rect =
				button
					.getBoundingClientRect();

			menu.style.top =
				`${rect.bottom + 5}px`;

			menu.style.left =
				`${Math.min(
					rect.left,
					window.innerWidth - 225
				)}px`;

			document
				.querySelectorAll(
					'.column-menu-button'
				)
				.forEach(
					(item) =>
						item
							.classList
							.remove('active')
				);

			button
				.classList
				.add('active');

			renderColumnFilter();

			menu
				.classList
				.add('open');
		}

		function renderColumnFilter() {
			const area =
				$('columnFilterArea');

			const column =
				state.activeColumn;

			const existing =
				state.columnFilters[
					column
				] ?? '';

			if (
				column === 'dpo' ||
				column === 'discrepancy'
			) {
				area.innerHTML = `
					<div class="yn-options">
						<button
							type="button"
							data-value="Y"
						>
							Y
						</button>

						<button
							type="button"
							data-value="N"
						>
							N
						</button>

						<button
							type="button"
							data-value=""
						>
							All
						</button>
					</div>
				`;

				area
					.querySelectorAll(
						'[data-value]'
					)
					.forEach(
						(button) => {
							button.onclick =
								() => {
									const value =
										button.dataset.value;

									if (value) {
										state.columnFilters[
											column
										] = value;
									} else {
										delete state.columnFilters[
											column
										];
									}

									state.page = 1;
									closeColumnMenu();
									loadRegistry();
								};
						}
					);

				return;
			}

			area.innerHTML = `
				<input
					id="columnFilterInput"
					class="column-filter-input"
					type="text"
					placeholder="Filter column..."
					value="${escapeHtml(existing)}"
				/>
			`;

			const input =
				$('columnFilterInput');

			input.onkeydown =
				(event) => {
					if (
						event.key !==
						'Enter'
					) {
						return;
					}

					const value =
						input.value.trim();

					if (value) {
						state.columnFilters[
							column
						] = value;
					} else {
						delete state.columnFilters[
							column
						];
					}

					state.page = 1;
					closeColumnMenu();
					loadRegistry();
				};

			setTimeout(
				() => input.focus(),
				0
			);
		}

		async function performSync() {
			$('syncModal')
				.classList
				.remove('open');

			$('sync').disabled = true;

			try {
				setSystemStatus(
					'Synchronising latest MCST records...',
					'amber'
				);

				const response =
					await fetch(
						'/api/sync-bca',
						{
							method: 'POST',
							cache: 'no-store'
						}
					);

				const data =
					await response.json();

				if (!data.ok) {
					throw new Error(
						data.error ||
						'MCST synchronisation failed.'
					);
				}

				await refreshStatus();

				if (
					state.mode !== 'empty'
				) {
					await loadRegistry();
				}

				setIdle();
			} catch (error) {
				setSystemStatus(
					error instanceof Error
						? error.message
						: String(error),
					'red'
				);
			} finally {
				$('sync').disabled =
					false;
			}
		}

		$('executeAssistant').onclick =
			() => {
				const query =
					$('assistantQuery')
						.value
						.trim();

				if (!query) {
					setSystemStatus(
						'Enter a query for the assistant.',
						'amber'
					);

					return;
				}

				setSystemStatus(
					'Assistant integration is not configured.',
					'amber'
				);
			};

		$('assistantQuery')
			.addEventListener(
				'keydown',
				(event) => {
					if (
						event.key ===
						'Enter'
					) {
						$('executeAssistant')
							.click();
					}
				}
			);

		$('executeSearch').onclick =
			executeSearch;

		$('loadFullTable').onclick =
			loadFullRegistry;

		[
			'searchMcst',
			'searchUen',
			'searchEstate',
			'searchDpoName',
			'searchDpoEmail'
		].forEach(
			(id) => {
				$(id)
					.addEventListener(
						'keydown',
						(event) => {
							if (
								event.key ===
								'Enter'
							) {
								executeSearch();
							}
						}
					);
			}
		);

		let keywordTimer;

		$('tableKeyword')
			.addEventListener(
				'input',
				() => {
					clearTimeout(
						keywordTimer
					);

					keywordTimer =
						setTimeout(
							() => {
								state.keyword =
									$('tableKeyword')
										.value
										.trim();

								state.page = 1;

								if (
									state.mode !==
									'empty'
								) {
									loadRegistry();
								}
							},
							300
						);
				}
			);

		$('pageSize').onchange =
			() => {
				state.pageSize =
					Number(
						$('pageSize')
							.value
					);

				state.page = 1;

				if (
					state.mode !==
					'empty'
				) {
					loadRegistry();
				} else {
					updatePagination();
				}
			};

		$('firstPage').onclick =
			() => {
				if (
					state.page <= 1
				) {
					return;
				}

				state.page = 1;
				loadRegistry();
			};

		$('previousPage').onclick =
			() => {
				if (
					state.page <= 1
				) {
					return;
				}

				state.page -= 1;
				loadRegistry();
			};

		$('nextPage').onclick =
			() => {
				if (
					state.page >=
					state.totalPages
				) {
					return;
				}

				state.page += 1;
				loadRegistry();
			};

		$('lastPage').onclick =
			() => {
				if (
					!state.totalPages
				) {
					return;
				}

				state.page =
					state.totalPages;

				loadRegistry();
			};

		$('jumpPage')
			.addEventListener(
				'keydown',
				(event) => {
					if (
						event.key !==
						'Enter'
					) {
						return;
					}

					const page =
						Math.max(
							1,
							Math.min(
								state.totalPages ||
									1,
								Number(
									$('jumpPage')
										.value
								) || 1
							)
						);

					state.page = page;

					if (
						state.mode !==
						'empty'
					) {
						loadRegistry();
					}
				}
			);

		document
			.querySelectorAll(
				'.column-menu-button'
			)
			.forEach(
				(button) => {
					button.onclick =
						(event) => {
							event.stopPropagation();

							if (
								$('columnMenu')
									.classList
									.contains(
										'open'
									) &&
								state.activeColumn ===
									button.dataset.column
							) {
								closeColumnMenu();
								return;
							}

							openColumnMenu(
								button
							);
						};
				}
			);

		$('sortAscending').onclick =
			() => {
				state.sortColumn =
					state.activeColumn;

				state.sortDirection =
					'asc';

				state.page = 1;
				closeColumnMenu();

				if (
					state.mode !==
					'empty'
				) {
					loadRegistry();
				}
			};

		$('sortDescending').onclick =
			() => {
				state.sortColumn =
					state.activeColumn;

				state.sortDirection =
					'desc';

				state.page = 1;
				closeColumnMenu();

				if (
					state.mode !==
					'empty'
				) {
					loadRegistry();
				}
			};

		$('clearColumnFilter').onclick =
			() => {
				delete state.columnFilters[
					state.activeColumn
				];

				if (
					state.sortColumn ===
					state.activeColumn
				) {
					state.sortColumn = '';
					state.sortDirection = '';
				}

				state.page = 1;
				closeColumnMenu();

				if (
					state.mode !==
					'empty'
				) {
					loadRegistry();
				}
			};

		document.addEventListener(
			'click',
			(event) => {
				const menu =
					$('columnMenu');

				if (
					menu.classList
						.contains('open') &&
					!menu.contains(
						event.target
					)
				) {
					closeColumnMenu();
				}
			}
		);

		$('sync').onclick =
			() => {
				$('syncModal')
					.classList
					.add('open');
			};

		$('cancelSync').onclick =
			() => {
				$('syncModal')
					.classList
					.remove('open');
			};

		$('confirmSync').onclick =
			performSync;

		$('syncModal').onclick =
			(event) => {
				if (
					event.target ===
					$('syncModal')
				) {
					$('syncModal')
						.classList
						.remove('open');
				}
			};

		async function initialise() {
			renderRows([]);
			updatePagination();

			try {
				setSystemStatus(
					'Loading registry status...',
					'amber'
				);

				await refreshStatus();

				setIdle();
			} catch (error) {
				setSystemStatus(
					error instanceof Error
						? error.message
						: String(error),
					'red'
				);
			}
		}

		initialise();
	</script>
</body>
</html>
