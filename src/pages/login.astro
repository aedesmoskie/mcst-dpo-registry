---
export const prerender = false;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<meta
			name="robots"
			content="noindex, nofollow"
		/>

		<title>Login | MCST DPO Registry</title>

		<style>
			:root {
				font-family:
					Inter,
					ui-sans-serif,
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					sans-serif;

				color-scheme: dark;

				--gold: #d6b978;
				--gold-light: #e4ca91;

				--blue: #078bff;
				--blue-light: #16a0ff;

				--text: #f5f8fc;
				--muted: #bdcbe0;

				--panel:
					rgba(7, 25, 46, 0.86);

				--field:
					rgba(13, 37, 63, 0.68);

				--border:
					rgba(121, 169, 218, 0.38);
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				width: 100%;
				min-height: 100%;
			}

			body {
				min-height: 100vh;
				background: #06172a;
				color: var(--text);
				overflow-x: hidden;
			}

			button,
			input {
				font: inherit;
			}

			.login-page {
				position: relative;

				width: 100%;
				min-height: 100vh;

				display: flex;
				align-items: center;

				background:
					linear-gradient(
						90deg,
						rgba(3, 20, 39, 0.28) 0%,
						rgba(3, 20, 39, 0.08) 45%,
						rgba(3, 20, 39, 0.18) 100%
					),
					url("/cerulius-login-bg.png")
						center center /
						cover
						no-repeat;

				isolation: isolate;
			}

			.login-page::after {
				content: "";

				position: absolute;
				inset: 0;
				z-index: -1;

				background:
					linear-gradient(
						180deg,
						rgba(0, 17, 36, 0.04),
						rgba(0, 11, 24, 0.16)
					);
			}

			.page-content {
				width: min(
					1440px,
					calc(100% - 96px)
				);

				margin: 0 auto;

				display: grid;
				grid-template-columns:
					minmax(360px, 0.9fr)
					minmax(470px, 0.95fr);

				align-items: center;

				gap: clamp(
					70px,
					9vw,
					170px
				);

				padding:
					64px
					0;
			}

			.brand {
				display: flex;
				flex-direction: column;
				align-items: center;

				transform:
					translateY(-24px);

				text-align: center;
			}

			.brand-mark {
				width: 122px;
				height: 122px;

				margin-bottom: 18px;

				color: var(--gold);
			}

			.brand-mark svg {
				display: block;
				width: 100%;
				height: 100%;
			}

			.brand-name {
				margin: 0;

				color: var(--gold-light);

				font-size:
					clamp(
						42px,
						4.1vw,
						64px
					);

				line-height: 1;

				font-weight: 650;

				letter-spacing:
					0.075em;

				text-shadow:
					0 2px 18px
					rgba(
						0,
						0,
						0,
						0.26
					);
			}

			.brand-description {
				margin:
					18px
					0
					0;

				color: var(--gold);

				font-size:
					clamp(
						17px,
						1.45vw,
						22px
					);

				font-weight: 500;

				letter-spacing:
					0.18em;

				text-shadow:
					0 2px 14px
					rgba(
						0,
						0,
						0,
						0.28
					);
			}

			.login-card {
				width: 100%;
				max-width: 570px;

				justify-self: end;

				padding:
					48px
					52px
					50px;

				border:
					1px solid
					rgba(
						31,
						148,
						255,
						0.62
					);

				border-radius: 28px;

				background:
					linear-gradient(
						145deg,
						rgba(
							11,
							36,
							64,
							0.92
						),
						rgba(
							5,
							24,
							45,
							0.90
						)
					);

				box-shadow:
					0 30px 90px
						rgba(
							0,
							0,
							0,
							0.38
						),
					inset
						0 1px 0
						rgba(
							255,
							255,
							255,
							0.035
						);

				backdrop-filter:
					blur(18px);

				-webkit-backdrop-filter:
					blur(18px);
			}

			.login-heading {
				margin: 0;

				text-align: center;

				font-size: 36px;
				line-height: 1.2;

				font-weight: 700;

				letter-spacing:
					-0.02em;
			}

			.login-subtitle {
				margin:
					16px
					0
					38px;

				text-align: center;

				color: #d0daea;

				font-size: 16px;
				line-height: 1.5;
			}

			.message {
				display: none;

				margin:
					0
					0
					20px;

				padding:
					12px
					14px;

				border:
					1px solid
					rgba(
						255,
						108,
						117,
						0.45
					);

				border-radius: 10px;

				background:
					rgba(
						128,
						25,
						37,
						0.24
					);

				color: #ffc5ca;

				font-size: 13px;
				line-height: 1.45;
			}

			.message.visible {
				display: block;
			}

			.form-group {
				margin-bottom: 18px;
			}

			.input-shell {
				position: relative;
			}

			.field-icon {
				position: absolute;

				left: 19px;
				top: 50%;

				width: 24px;
				height: 24px;

				transform:
					translateY(-50%);

				color: #abc6eb;

				pointer-events: none;
			}

			.field-icon svg {
				display: block;
				width: 100%;
				height: 100%;
			}

			input {
				width: 100%;
				height: 66px;

				border:
					1px solid
					var(--border);

				border-radius: 10px;

				background:
					var(--field);

				color: #ffffff;

				padding:
					0
					56px
					0
					58px;

				outline: none;

				font-size: 15px;

				transition:
					border-color
						140ms ease,
					box-shadow
						140ms ease,
					background
						140ms ease;
			}

			input::placeholder {
				color: #8298b8;
			}

			input:focus {
				border-color:
					rgba(
						25,
						157,
						255,
						0.95
					);

				background:
					rgba(
						15,
						43,
						73,
						0.82
					);

				box-shadow:
					0 0 0 3px
						rgba(
							0,
							145,
							255,
							0.12
						);
			}

			.password-toggle {
				position: absolute;

				right: 13px;
				top: 50%;

				width: 42px;
				height: 42px;

				margin: 0;

				transform:
					translateY(-50%);

				display: grid;
				place-items: center;

				border: 0;
				border-radius: 8px;

				background: transparent;

				color: #aac4e8;

				cursor: pointer;

				padding: 0;
			}

			.password-toggle:hover {
				background:
					rgba(
						255,
						255,
						255,
						0.05
					);

				color: #ffffff;
			}

			.password-toggle svg {
				width: 23px;
				height: 23px;
			}

			.sign-in-button {
				width: 100%;
				height: 64px;

				margin-top: 9px;

				border: 0;
				border-radius: 9px;

				background:
					linear-gradient(
						90deg,
						#0787ff,
						#079cff
					);

				color: #ffffff;

				font-size: 16px;
				font-weight: 700;

				cursor: pointer;

				box-shadow:
					0 12px 30px
						rgba(
							0,
							126,
							255,
							0.19
						);

				transition:
					transform
						120ms ease,
					filter
						120ms ease,
					opacity
						120ms ease;
			}

			.sign-in-button:hover:not(
				:disabled
			) {
				filter:
					brightness(1.08);

				transform:
					translateY(-1px);
			}

			.sign-in-button:active:not(
				:disabled
			) {
				transform:
					translateY(0);
			}

			.sign-in-button:disabled {
				cursor: wait;
				opacity: 0.68;
			}

			.authorised-note {
				margin:
					22px
					0
					0;

				text-align: center;

				color:
					rgba(
						190,
						204,
						222,
						0.65
					);

				font-size: 11px;
				letter-spacing:
					0.05em;
			}

			@media (
				max-width: 1000px
			) {
				.page-content {
					width: min(
						720px,
						calc(
							100% - 40px
						)
					);

					grid-template-columns:
						1fr;

					gap: 38px;

					padding:
						48px
						0;
				}

				.brand {
					transform: none;
				}

				.brand-mark {
					width: 86px;
					height: 86px;
					margin-bottom: 12px;
				}

				.brand-name {
					font-size: 42px;
				}

				.brand-description {
					margin-top: 12px;
					font-size: 15px;
				}

				.login-card {
					max-width: 540px;
					justify-self: center;
				}
			}

			@media (
				max-width: 600px
			) {
				.login-page {
					background-position:
						center center;
				}

				.page-content {
					width:
						calc(
							100% - 28px
						);

					gap: 28px;

					padding:
						30px
						0;
				}

				.brand-mark {
					width: 72px;
					height: 72px;
				}

				.brand-name {
					font-size: 32px;
				}

				.brand-description {
					font-size: 12px;
					letter-spacing:
						0.15em;
				}

				.login-card {
					padding:
						34px
						22px
						32px;

					border-radius: 20px;
				}

				.login-heading {
					font-size: 29px;
				}

				.login-subtitle {
					margin-bottom: 28px;
					font-size: 14px;
				}

				input {
					height: 58px;
				}

				.sign-in-button {
					height: 58px;
				}
			}
		</style>
	</head>

	<body>
		<main class="login-page">
			<div class="page-content">
				<section
					class="brand"
					aria-label="Cerulius"
				>
					<div
						class="brand-mark"
						aria-hidden="true"
					>
						<svg
							viewBox="0 0 120 120"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M60 8L103 31V77L60 105L17 77V31L60 8Z"
								stroke="currentColor"
								stroke-width="9"
								stroke-linejoin="round"
							/>

							<path
								d="M60 34L80 45V67L60 80L40 67V45L60 34Z"
								stroke="currentColor"
								stroke-width="9"
								stroke-linejoin="round"
							/>
						</svg>
					</div>

					<h1 class="brand-name">
						CERULIUS
					</h1>

					<p class="brand-description">
						DPO as a Service
					</p>
				</section>

				<section
					class="login-card"
					aria-labelledby="login-title"
				>
					<h2
						id="login-title"
						class="login-heading"
					>
						Sign In
					</h2>

					<p class="login-subtitle">
						Access the MCST DPO Registry
					</p>

					<p
						id="login-message"
						class="message"
						role="alert"
						aria-live="polite"
					></p>

					<form id="login-form">
						<div class="form-group">
							<div class="input-shell">
								<span
									class="field-icon"
									aria-hidden="true"
								>
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<circle
											cx="12"
											cy="8"
											r="4"
										></circle>

										<path
											d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2"
										></path>
									</svg>
								</span>

								<input
									id="email"
									name="email"
									type="email"
									autocomplete="username"
									maxlength="254"
									required
									autofocus
									aria-label="Email address"
									placeholder="Email address"
								/>
							</div>
						</div>

						<div class="form-group">
							<div class="input-shell">
								<span
									class="field-icon"
									aria-hidden="true"
								>
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<rect
											x="5"
											y="10"
											width="14"
											height="10"
											rx="2"
										></rect>

										<path
											d="M8 10V7a4 4 0 0 1 8 0v3"
										></path>
									</svg>
								</span>

								<input
									id="password"
									name="password"
									type="password"
									autocomplete="current-password"
									maxlength="256"
									required
									aria-label="Password"
									placeholder="Password"
								/>

								<button
									id="password-toggle"
									class="password-toggle"
									type="button"
									aria-label="Show password"
									title="Show password"
								>
									<svg
										id="eye-visible"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path
											d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
										></path>

										<circle
											cx="12"
											cy="12"
											r="2.8"
										></circle>
									</svg>

									<svg
										id="eye-hidden"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										style="display:none"
									>
										<path
											d="M3 3l18 18"
										></path>

										<path
											d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6 0 9.5 6 9.5 6a17.3 17.3 0 0 1-3.1 3.8"
										></path>

										<path
											d="M6.1 6.1C3.8 7.7 2.5 12 2.5 12s3.5 6 9.5 6a9.7 9.7 0 0 0 3-.5"
										></path>
									</svg>
								</button>
							</div>
						</div>

						<button
							id="login-button"
							class="sign-in-button"
							type="submit"
						>
							Sign In
						</button>
					</form>

					<p class="authorised-note">
						Authorised access only
					</p>
				</section>
			</div>
		</main>

		<script>
			const form =
				document.getElementById(
					'login-form'
				);

			const emailInput =
				document.getElementById(
					'email'
				);

			const passwordInput =
				document.getElementById(
					'password'
				);

			const button =
				document.getElementById(
					'login-button'
				);

			const message =
				document.getElementById(
					'login-message'
				);

			const passwordToggle =
				document.getElementById(
					'password-toggle'
				);

			const eyeVisible =
				document.getElementById(
					'eye-visible'
				);

			const eyeHidden =
				document.getElementById(
					'eye-hidden'
				);


			function showMessage(text) {
				message.textContent =
					text;

				message.classList.add(
					'visible'
				);
			}


			function clearMessage() {
				message.textContent =
					'';

				message.classList.remove(
					'visible'
				);
			}


			passwordToggle.addEventListener(
				'click',
				() => {
					const showing =
						passwordInput.type ===
						'text';

					passwordInput.type =
						showing
							? 'password'
							: 'text';

					passwordToggle.setAttribute(
						'aria-label',
						showing
							? 'Show password'
							: 'Hide password'
					);

					passwordToggle.setAttribute(
						'title',
						showing
							? 'Show password'
							: 'Hide password'
					);

					eyeVisible.style.display =
						showing
							? ''
							: 'none';

					eyeHidden.style.display =
						showing
							? 'none'
							: '';
				}
			);


			form.addEventListener(
				'submit',
				async (event) => {
					event.preventDefault();

					clearMessage();

					const email =
						emailInput.value
							.trim();

					const password =
						passwordInput.value;


					if (
						!email ||
						!password
					) {
						showMessage(
							'Enter your email and password.'
						);

						return;
					}


					button.disabled =
						true;

					button.textContent =
						'Signing in...';


					try {
						const response =
							await fetch(
								'/api/auth/login',
								{
									method:
										'POST',

									headers: {
										'Content-Type':
											'application/json'
									},

									credentials:
										'same-origin',

									body:
										JSON.stringify(
											{
												email,
												password
											}
										)
								}
							);


						const result =
							await response
								.json()
								.catch(
									() => null
								);


						if (
							!response.ok ||
							!result?.ok
						) {
							showMessage(
								result?.error ??
									'Unable to sign in.'
							);

							passwordInput.value =
								'';

							passwordInput.focus();

							return;
						}


						window.location.replace(
							'/'
						);

					} catch (error) {
						console.error(
							'Login request failed:',
							error
						);

						showMessage(
							'Unable to sign in. Please try again.'
						);

					} finally {
						button.disabled =
							false;

						button.textContent =
							'Sign In';
					}
				}
			);
		</script>
	</body>
</html>
