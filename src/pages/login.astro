---
export const prerender = false;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<meta
			name="robots"
			content="noindex, nofollow"
		/>

		<title>Login | MCST DPO Registry</title>

		<style>
			:root {
				font-family:
					Inter,
					ui-sans-serif,
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					sans-serif;

				color-scheme: dark;

				--gold: #d6b978;
				--gold-light: #e4ca91;
				--text: #f5f8fc;
				--field: rgba(13, 37, 63, 0.72);
				--border: rgba(121, 169, 218, 0.38);
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				width: 100%;
				height: 100%;
				min-height: 100%;
			}

			body {
				min-height: 100vh;
				background: #06172a;
				color: var(--text);
				overflow-x: hidden;
			}

			button,
			input {
				font: inherit;
			}

			.login-page {
				position: relative;
				width: 100%;
				min-height: 100vh;

				background:
					linear-gradient(
						90deg,
						rgba(3, 20, 39, 0.14) 0%,
						rgba(3, 20, 39, 0.03) 48%,
						rgba(3, 20, 39, 0.12) 100%
					),
					url("/cerulius-login-bg.png")
						center center /
						cover
						no-repeat;

				overflow: hidden;
			}

			/* -------------------------------------------------
			   CERULIUS BRAND
			   Compact lockup positioned in open blue-sky area
			   ------------------------------------------------- */

			.brand {
				position: absolute;

				left: 25%;
				top: 21%;

				width: 300px;

				display: flex;
				flex-direction: column;
				align-items: center;

				text-align: center;

				transform: translateX(calc(-50% + 40px));
			}

			.brand-mark {
				width: 70px;
				height: 70px;

				margin-bottom: 7px;

				color: var(--gold);
			}

			.brand-mark svg {
				display: block;
				width: 100%;
				height: 100%;
			}

			.brand-name {
				margin: 0;

				color: var(--gold-light);

				font-size: 36px;
				line-height: 1;

				font-weight: 650;

				letter-spacing: 0.075em;

				text-shadow:
					0 2px 16px
					rgba(0, 0, 0, 0.3);
			}

			.brand-description {
				margin:
					7px
					0
					0;

				color: var(--gold);

				font-size: 12px;
				line-height: 1.2;

				font-weight: 500;

				letter-spacing: 0.16em;

				text-shadow:
					0 2px 12px
					rgba(0, 0, 0, 0.35);
			}

			/* -------------------------------------------------
			   LOGIN CARD
			   ------------------------------------------------- */

			.login-card {
				position: absolute;

				right: calc(9% + 40px);
				top: 50%;

				transform: translateY(-50%);

				width: 380px;

				padding:
					29px
					31px
					25px;

				border:
					1px solid
					rgba(31, 148, 255, 0.58);

				border-radius: 18px;

				background:
					linear-gradient(
						145deg,
						rgba(11, 36, 64, 0.91),
						rgba(5, 24, 45, 0.91)
					);

				box-shadow:
					0 22px 60px
						rgba(0, 0, 0, 0.34),
					inset
						0 1px 0
						rgba(255, 255, 255, 0.035);

				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
			}

			.login-heading {
				margin: 0;

				text-align: center;

				font-size: 26px;
				line-height: 1.2;

				font-weight: 700;

				letter-spacing: -0.02em;
			}

			.login-subtitle {
				margin:
					9px
					0
					22px;

				text-align: center;

				color: #d0daea;

				font-size: 12.5px;
				line-height: 1.5;
			}

			.message {
				display: none;

				margin:
					0
					0
					13px;

				padding:
					9px
					11px;

				border:
					1px solid
					rgba(255, 108, 117, 0.45);

				border-radius: 8px;

				background:
					rgba(128, 25, 37, 0.24);

				color: #ffc5ca;

				font-size: 11.5px;
				line-height: 1.45;
			}

			.message.visible {
				display: block;
			}

			.form-group {
				margin-bottom: 12px;
			}

			.input-shell {
				position: relative;
			}

			.field-icon {
				position: absolute;

				left: 15px;
				top: 50%;

				width: 18px;
				height: 18px;

				transform: translateY(-50%);

				color: #abc6eb;

				pointer-events: none;
			}

			.field-icon svg {
				display: block;
				width: 100%;
				height: 100%;
			}

			input {
				width: 100%;
				height: 47px;

				border:
					1px solid
					var(--border);

				border-radius: 8px;

				background: var(--field);
				color: #ffffff;

				padding:
					0
					45px
					0
					43px;

				outline: none;

				font-size: 12.5px;

				transition:
					border-color 140ms ease,
					box-shadow 140ms ease,
					background 140ms ease;
			}

			input::placeholder {
				color: #8298b8;
			}

			input:focus {
				border-color:
					rgba(25, 157, 255, 0.95);

				background:
					rgba(15, 43, 73, 0.84);

				box-shadow:
					0 0 0 3px
					rgba(0, 145, 255, 0.11);
			}

			.password-toggle {
				position: absolute;

				right: 7px;
				top: 50%;

				width: 35px;
				height: 35px;

				transform: translateY(-50%);

				display: grid;
				place-items: center;

				margin: 0;
				padding: 0;

				border: 0;
				border-radius: 7px;

				background: transparent;

				color: #aac4e8;

				cursor: pointer;
			}

			.password-toggle:hover {
				background:
					rgba(255, 255, 255, 0.05);

				color: #ffffff;
			}

			.password-toggle svg {
				width: 18px;
				height: 18px;
			}

			.sign-in-button {
				width: 100%;
				height: 46px;

				margin-top: 5px;

				border: 0;
				border-radius: 8px;

				background:
					linear-gradient(
						90deg,
						#0787ff,
						#079cff
					);

				color: #ffffff;

				font-size: 13px;
				font-weight: 700;

				cursor: pointer;

				box-shadow:
					0 9px 22px
					rgba(0, 126, 255, 0.18);

				transition:
					transform 120ms ease,
					filter 120ms ease,
					opacity 120ms ease;
			}

			.sign-in-button:hover:not(:disabled) {
				filter: brightness(1.08);
				transform: translateY(-1px);
			}

			.sign-in-button:active:not(:disabled) {
				transform: translateY(0);
			}

			.sign-in-button:disabled {
				cursor: wait;
				opacity: 0.68;
			}

			.authorised-note {
				margin:
					13px
					0
					0;

				text-align: center;

				color:
					rgba(190, 204, 222, 0.55);

				font-size: 8.5px;

				letter-spacing: 0.05em;
			}

			/* -------------------------------------------------
			   RESPONSIVE
			   ------------------------------------------------- */

			@media (max-width: 1100px) {
				.brand {
					left: 24%;
				}

				.login-card {
					right: 5%;
					width: 370px;
				}
			}

			@media (max-width: 850px) {
				.login-page {
					min-height: 100vh;

					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;

					gap: 24px;

					padding:
						30px
						20px;

					background-position: center center;

					overflow: auto;
				}

				.brand {
					position: static;

					width: auto;

					transform: none;
				}

				.brand-mark {
					width: 62px;
					height: 62px;

					margin-bottom: 6px;
				}

				.brand-name {
					font-size: 30px;
				}

				.brand-description {
					margin-top: 6px;

					font-size: 10.5px;
				}

				.login-card {
					position: static;

					width: min(100%, 380px);

					transform: none;
				}
			}

			@media (max-width: 500px) {
				.login-page {
					gap: 20px;

					padding:
						22px
						14px;
				}

				.brand-mark {
					width: 56px;
					height: 56px;
				}

				.brand-name {
					font-size: 27px;
				}

				.brand-description {
					font-size: 10px;
				}

				.login-card {
					padding:
						26px
						21px
						23px;

					border-radius: 16px;
				}

				.login-heading {
					font-size: 24px;
				}

				.login-subtitle {
					margin-bottom: 20px;

					font-size: 12px;
				}
			}
		</style>
	</head>

	<body>
		<main class="login-page">
			<section
				class="brand"
				aria-label="Cerulius"
			>
				<div
					class="brand-mark"
					aria-hidden="true"
				>
					<svg
						viewBox="0 0 120 120"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M60 8L103 31V77L60 105L17 77V31L60 8Z"
							stroke="currentColor"
							stroke-width="9"
							stroke-linejoin="round"
						/>

						<path
							d="M60 34L80 45V67L60 80L40 67V45L60 34Z"
							stroke="currentColor"
							stroke-width="9"
							stroke-linejoin="round"
						/>
					</svg>
				</div>

				<h1 class="brand-name">
					CERULIUS
				</h1>

				<p class="brand-description">
					DPO as a Service
				</p>
			</section>

			<section
				class="login-card"
				aria-labelledby="login-title"
			>
				<h2
					id="login-title"
					class="login-heading"
				>
					Sign In
				</h2>

				<p class="login-subtitle">
					Access the MCST DPO Registry
				</p>

				<p
					id="login-message"
					class="message"
					role="alert"
					aria-live="polite"
				></p>

				<form id="login-form">
					<div class="form-group">
						<div class="input-shell">
							<span
								class="field-icon"
								aria-hidden="true"
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle
										cx="12"
										cy="8"
										r="4"
									></circle>

									<path
										d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2"
									></path>
								</svg>
							</span>

							<input
								id="email"
								name="email"
								type="email"
								autocomplete="username"
								maxlength="254"
								required
								autofocus
								aria-label="Email address"
								placeholder="Email address"
							/>
						</div>
					</div>

					<div class="form-group">
						<div class="input-shell">
							<span
								class="field-icon"
								aria-hidden="true"
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<rect
										x="5"
										y="10"
										width="14"
										height="10"
										rx="2"
									></rect>

									<path
										d="M8 10V7a4 4 0 0 1 8 0v3"
									></path>
								</svg>
							</span>

							<input
								id="password"
								name="password"
								type="password"
								autocomplete="current-password"
								maxlength="256"
								required
								aria-label="Password"
								placeholder="Password"
							/>

							<button
								id="password-toggle"
								class="password-toggle"
								type="button"
								aria-label="Show password"
								title="Show password"
							>
								<svg
									id="eye-visible"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path
										d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
									></path>

									<circle
										cx="12"
										cy="12"
										r="2.8"
									></circle>
								</svg>

								<svg
									id="eye-hidden"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									style="display:none"
								>
									<path
										d="M3 3l18 18"
									></path>

									<path
										d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6 0 9.5 6 9.5 6a17.3 17.3 0 0 1-3.1 3.8"
									></path>

									<path
										d="M6.1 6.1C3.8 7.7 2.5 12 2.5 12s3.5 6 9.5 6a9.7 9.7 0 0 0 3-.5"
									></path>
								</svg>
							</button>
						</div>
					</div>

					<button
						id="login-button"
						class="sign-in-button"
						type="submit"
					>
						Sign In
					</button>
				</form>

				<p class="authorised-note">
					Authorised access only
				</p>
			</section>
		</main>

		<script>
			const form =
				document.getElementById(
					'login-form'
				);

			const emailInput =
				document.getElementById(
					'email'
				);

			const passwordInput =
				document.getElementById(
					'password'
				);

			const button =
				document.getElementById(
					'login-button'
				);

			const message =
				document.getElementById(
					'login-message'
				);

			const passwordToggle =
				document.getElementById(
					'password-toggle'
				);

			const eyeVisible =
				document.getElementById(
					'eye-visible'
				);

			const eyeHidden =
				document.getElementById(
					'eye-hidden'
				);

			function showMessage(text) {
				message.textContent = text;

				message.classList.add(
					'visible'
				);
			}

			function clearMessage() {
				message.textContent = '';

				message.classList.remove(
					'visible'
				);
			}

			passwordToggle.addEventListener(
				'click',
				() => {
					const showing =
						passwordInput.type ===
						'text';

					passwordInput.type =
						showing
							? 'password'
							: 'text';

					passwordToggle.setAttribute(
						'aria-label',
						showing
							? 'Show password'
							: 'Hide password'
					);

					passwordToggle.setAttribute(
						'title',
						showing
							? 'Show password'
							: 'Hide password'
					);

					eyeVisible.style.display =
						showing
							? ''
							: 'none';

					eyeHidden.style.display =
						showing
							? 'none'
							: '';
				}
			);

			form.addEventListener(
				'submit',
				async (event) => {
					event.preventDefault();

					clearMessage();

					const email =
						emailInput.value.trim();

					const password =
						passwordInput.value;

					if (
						!email ||
						!password
					) {
						showMessage(
							'Enter your email and password.'
						);

						return;
					}

					button.disabled = true;

					button.textContent =
						'Signing in...';

					try {
						const response =
							await fetch(
								'/api/auth/login',
								{
									method:
										'POST',

									headers: {
										'Content-Type':
											'application/json'
									},

									credentials:
										'same-origin',

									body:
										JSON.stringify(
											{
												email,
												password
											}
										)
								}
							);

						const result =
							await response
								.json()
								.catch(
									() => null
								);

						if (
							!response.ok ||
							!result?.ok
						) {
							showMessage(
								result?.error ??
									'Unable to sign in.'
							);

							passwordInput.value =
								'';

							passwordInput.focus();

							return;
						}

						window.location.replace(
							'/'
						);

					} catch (error) {
						console.error(
							'Login request failed:',
							error
						);

						showMessage(
							'Unable to sign in. Please try again.'
						);

					} finally {
						button.disabled =
							false;

						button.textContent =
							'Sign In';
					}
				}
			);
		</script>
	</body>
</html>
